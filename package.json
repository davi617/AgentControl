{
  "name": "agent-control",
  "version": "4.1.1",
  "private": true,
  "description": "Agent Control: sala onde você vê todos os agentes de IA, recebe resumos, manda comandos e aprova os perigosos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "gate": "node src/gate.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc -p .",
    "cli": "node bin/agentcontrol.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "agentcontrol": "bin/agentcontrol.mjs"
  }
}
