#!/usr/bin/env bash
# Exemplo (Linux/macOS). Copie para ~/.config/dw-agents/launchers/hermes.sh e ajuste.
# O agent-loop.sh já entrega: $WORKTREE (pasta do agente), $PROMPT (ordem padrão) e as funções de comum.sh.
set -e
cd "$WORKTREE"
EFFORT="$(cat "$HOME/.config/dw-agents/effort-hermes.txt" 2>/dev/null || echo ultra)"
exec hermes --ignore-rules --in "." --reasoning "$EFFORT" -z "$PROMPT"
