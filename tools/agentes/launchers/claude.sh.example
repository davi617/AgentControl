#!/usr/bin/env bash
# Exemplo (Linux/macOS). Copie para ~/.config/dw-agents/launchers/claude.sh e ajuste.
# O agent-loop.sh já entrega: $WORKTREE (pasta do agente), $PROMPT (ordem padrão) e as funções de comum.sh.
set -e
cd "$WORKTREE"
# Claude isolado: config própria (não mexe no Claude do usuário) e chave da fila só neste processo.
export CLAUDE_CONFIG_DIR="$HOME/.config/dw-agents/claude-agent-home"
export ANTHROPIC_BASE_URL="${ROUTER_URL:-http://127.0.0.1:20129}/a/claude/v1"
export ANTHROPIC_AUTH_TOKEN="$(router_key)"
exec claude -p "$PROMPT" --permission-mode acceptEdits \
  --allowedTools "Read" "Grep" "Glob" "Bash(git status:*)" "Bash(git diff:*)" "Bash(git log:*)" "Bash(git add:*)" "Bash(git commit:*)" "Bash(pnpm:*)" "Bash(node:*)" "Bash(npx:*)" "Bash(ls:*)" \
  --disallowedTools "Bash(git push:*)" "Bash(git checkout:*)" "Bash(git switch:*)" "Bash(git reset:*)" "Bash(git rebase:*)" "Bash(git merge:*)"
