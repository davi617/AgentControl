#!/usr/bin/env bash
# Exemplo (Linux/macOS). Copie para ~/.config/agent-control/launchers/grok.sh e ajuste.
# O agent-loop.sh já entrega: $WORKTREE (pasta do agente), $PROMPT (ordem padrão) e as funções de comum.sh.
set -e
cd "$WORKTREE"
# Grok CLI (xAI). Precisa de GROK_API_KEY no ambiente (nunca no arquivo).
exec grok -p "$PROMPT"
